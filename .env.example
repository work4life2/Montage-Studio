# Copy to .env and adjust. Secrets go in .env.local (git-ignored, loaded first).

# ───────────────────────── Termix ─────────────────────────
# bsc | base | rh — each chain is a separate marketplace. The four agents were minted on bsc.
AACP_CHAIN=bsc
A2A_RPC_URL=https://bsc-dataseed.bnbchain.org
# One hot wallet per agent (key mode, unattended). In .env.local:
#   MONTAGE_WALLET_KEY=0x…  RENDERFARM_WALLET_KEY=0x…  BEATSMITH_WALLET_KEY=0x…  SKETCHBOARD_WALLET_KEY=0x…
# Agent ids default to the agents minted on 2026-11-03; override with <ROLE>_AGENT_ID.
# Listing ids are written to data/listings.json by `npm run setup -- listing all`; override with <ROLE>_LISTING_ID.
# Which agents this process hosts (comma-separated).
SERVE_ROLES=montage,renderfarm,beatsmith,sketchboard
CURRENCY=USDC

# ───────────────────────── Models (cun.ai relay) ─────────────────────────
RELAY_BASE_URL=https://www.cun.ai
#   RELAY_API_KEY=sk-…   (in .env.local)
CHAT_MODEL=claude-sonnet-5-5
PLAN_MODEL=claude-sonnet-5-5
IMAGE_MODEL=gpt-image-2

# ───────────────────────── Cost basis (USD) ─────────────────────────
# Prices are cost-plus: Montage Studio and RenderFarm +50 %, Beatsmith and Sketchboard +20 %;
# the 2 % platform fee and gas are part of the cost. These are the unit costs the quotes use.
RUNWAY_USD_PER_CREDIT=0.0156
IMAGE_USD=0.125
GAS_USD_PER_TX=0.02

# ───────────────────────── Runway account ─────────────────────────
# `npm run auth -- runway` signs in through the browser once; the grant (with a refresh token) lives
# in data/oauth/. Video, Lyria 3 and Eleven Music all run on it. On a server, forward the callback port first:
#   ssh -L 53682:127.0.0.1:53682 root@<server>
OAUTH_CALLBACK_PORT=53682

# ───────────────────────── Service ─────────────────────────
DATA_DIR=./data
HTTP_HOST=127.0.0.1
HTTP_PORT=8795
DASHBOARD_PATH=
JOB_TIMEOUT_MINUTES=240
SWEEP_INTERVAL_SECONDS=300
NOTIFY_WEBHOOK_URL=
